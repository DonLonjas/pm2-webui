# Plantilla de variables de entorno de PM2 WebUI.
# Copia este archivo a .env y ajusta los valores:  cp env.example .env
# NUNCA subas el .env real al repositorio (ya está en .gitignore).

# --- Servidor ---
# Interfaz en la que escucha la web (127.0.0.1 = solo local, 0.0.0.0 = accesible desde la red)
HOST=127.0.0.1
# Puerto de escucha
PORT=4343

# --- Autenticación ---
# Secreto para firmar la sesión. Genera uno único, ej: openssl rand -hex 32
APP_SESSION_SECRET=
# Usuario admin
APP_USERNAME=
# hash bcrypt de la contraseña (script npm run setup-admin-user)
APP_PASSWORD=

# --- UI ---
# Mostrar información de git en la interfaz
SHOW_GIT_INFO=true
# Mostrar el contenido del archivo .env en la interfaz
SHOW_ENV_FILE=false

# --- Cloudflare Tunnels ---
# Directorio donde cloudflared guarda cert.pem y su configuración
CLOUDFLARED_DIR=/home/USUARIO/.cloudflared
# Ruta al config.yml de cloudflared (opcional si CLOUDFLARED_DIR ya definida)
CLOUDFLARED_CONFIG_PATH=/home/USUARIO/.cloudflared/config.yml
